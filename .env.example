# --- required in production ---
DATABASE_PATH=./data/autoauction.db
SESSION_COOKIE_NAME=aa_session
APP_BASE_URL=http://localhost:3100

# --- media storage ---
# Public vehicle images are always stored under ./public/uploads (served
# statically) — not configurable. Private docs live outside the public dir.
DOCUMENTS_DIR=./data/documents       # private docs (outside public/)

# --- email (password reset) ---
# "outbox" = dev: append to data/outbox.log. "webhook" = POST to EMAIL_WEBHOOK_URL.
EMAIL_TRANSPORT=outbox
# EMAIL_WEBHOOK_URL=https://your-mail-endpoint
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_ALLOW_OUTBOX=1               # allow outbox transport in prod (smoke tests)

# --- misc ---
# BACKUP_KEEP=10                     # backups kept by scripts/backup.mjs
# ALLOW_DEV_SEED=1                   # DANGER: permits db:seed in production
# ALLOW_LOCALHOST_DEPLOY=1           # local demo/prod-sim only — permits
                                    # localhost APP_BASE_URL under NODE_ENV=production

# --- site ---
# NEXT_PUBLIC_CONTACT_EMAIL=support@yourdomain.com   # shown in the footer when set
